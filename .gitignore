# Nada de secretos en el repo: el token de sincronización vive solo en el
# navegador de cada dispositivo, nunca en un archivo versionado.
*.token
*.secret
.env
.env.*
config.local.js

# Respaldos exportados desde la app (contienen tus datos personales)
notara-respaldo-*.json
mainquest-respaldo-*.json

# Configuración local de herramientas
.claude/

# Ruido del sistema
Thumbs.db
desktop.ini
.DS_Store

# Basura que genera la CLI de Supabase al conectarse con el proyecto.
# No es del proyecto y se rehace sola.
supabase/.temp/

# Banco de pruebas local del lienzo. Vive fuera de la app para poder mirar
# un cambio antes de subirlo, y NO se publica: no está en index.html ni en
# la lista ASSETS de sw.js.
pruebas/
