<?xml version="1.0" encoding="utf-8"?>
<!-- El aviso ABIERTO (0.7.163): al deslizarlo. Arriba el icono, el rótulo, el
     nombre (dos renglones como mucho) y la cifra con su rótulo ENCIMA; debajo
     los tramos con su texto; y los botones a lo ancho. Android deja 256 dp como
     mucho; el más alto mide unos 232 con textos larguísimos. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView android:id="@+id/av_borde" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/aviso_marco" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/av_fondo" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_margin="1.5dp" android:scaleType="fitXY" android:src="@drawable/aviso_marco_dentro"
        android:importantForAccessibility="no" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">

            <ImageView android:id="@+id/av_icono" android:layout_width="48dp" android:layout_height="48dp"
                android:scaleType="fitCenter" android:importantForAccessibility="no" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="14dp" android:orientation="vertical">
                <TextView android:id="@+id/av_ceja" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="11sp" android:fontFamily="@font/outfit_bold" android:letterSpacing="0.12"
                    android:textAllCaps="true" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
                <TextView android:id="@+id/av_tit" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="3dp" android:textSize="18sp" android:fontFamily="@font/outfit_semibold"
                    android:maxLines="2" android:ellipsize="end" />
                <TextView android:id="@+id/av_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="3dp" android:textSize="14sp" android:fontFamily="@font/outfit_medium"
                    android:maxLines="2" android:ellipsize="end" android:visibility="gone" />
            </LinearLayout>

            <LinearLayout android:id="@+id/av_der" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="14dp" android:orientation="vertical" android:gravity="end">
                <TextView android:id="@+id/av_rot" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="end" android:textSize="10.5sp" android:fontFamily="@font/outfit_bold"
                    android:letterSpacing="0.1" android:textAllCaps="true" android:maxLines="1" android:visibility="gone" />
                <Chronometer android:id="@+id/av_crono" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="end" android:layout_marginTop="5dp" android:textSize="36sp"
                    android:fontFamily="@font/outfit_medium" android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false" android:visibility="gone" />
                <TextView android:id="@+id/av_num" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="end" android:layout_marginTop="5dp" android:textSize="36sp"
                    android:fontFamily="@font/outfit_medium" android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false" android:maxLines="1" android:visibility="gone" />
                <FrameLayout android:id="@+id/av_dchip" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:visibility="gone">
                <ImageView android:id="@+id/av_dchip_fondo" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="fitXY" android:src="@drawable/aviso_chip" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="6dp" android:paddingBottom="6dp">
                    <ImageView android:id="@+id/av_dchip_ic" android:layout_width="12dp" android:layout_height="12dp"
                        android:layout_marginEnd="6dp" android:visibility="gone" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/av_dchip_tx" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="11sp" android:fontFamily="@font/outfit_bold" android:letterSpacing="0.06"
                        android:textAllCaps="true" android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/av_pie" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:minHeight="26dp" android:orientation="horizontal"
            android:gravity="center_vertical" android:visibility="gone">
            <FrameLayout android:id="@+id/av_chip" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:visibility="gone">
                <ImageView android:id="@+id/av_chip_fondo" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="fitXY" android:src="@drawable/aviso_chip" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="6dp" android:paddingBottom="6dp">
                    <ImageView android:id="@+id/av_chip_ic" android:layout_width="12dp" android:layout_height="12dp"
                        android:layout_marginEnd="6dp" android:visibility="gone" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/av_chip_tx" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="11sp" android:fontFamily="@font/outfit_bold" android:letterSpacing="0.06"
                        android:textAllCaps="true" android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>
            <LinearLayout android:id="@+id/av_puntos" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="10dp" android:orientation="horizontal" android:gravity="center_vertical"
                android:visibility="gone">
                <ImageView android:id="@+id/av_p1" android:layout_width="10dp" android:layout_height="10dp"
                    android:importantForAccessibility="no" />
                <ImageView android:id="@+id/av_p2" android:layout_width="10dp" android:layout_height="10dp"
                    android:layout_marginStart="6dp" android:importantForAccessibility="no" />
                <ImageView android:id="@+id/av_p3" android:layout_width="10dp" android:layout_height="10dp"
                    android:layout_marginStart="6dp" android:importantForAccessibility="no" />
                <ImageView android:id="@+id/av_p4" android:layout_width="10dp" android:layout_height="10dp"
                    android:layout_marginStart="6dp" android:importantForAccessibility="no" />
            </LinearLayout>
            <TextView android:id="@+id/av_tramo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="10dp" android:textSize="13sp" android:fontFamily="@font/outfit_semibold"
                android:maxLines="1" android:visibility="gone" />
            <TextView android:id="@+id/av_dato" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:paddingStart="10dp" android:gravity="end"
                android:textSize="13sp" android:fontFamily="@font/outfit_medium" android:maxLines="1"
                android:ellipsize="end" android:visibility="gone" />
        </LinearLayout>

        <LinearLayout android:id="@+id/av_acc" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:orientation="horizontal" android:visibility="gone">
            <FrameLayout android:id="@+id/av_b1" android:layout_width="0dp" android:layout_height="42dp"
                android:layout_weight="1" android:visibility="gone">
                <ImageView android:id="@+id/av_b1_borde" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="fitXY" android:src="@drawable/aviso_boton" android:importantForAccessibility="no" />
                <ImageView android:id="@+id/av_b1_fondo" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:layout_margin="1.5dp" android:scaleType="fitXY" android:src="@drawable/aviso_boton_dentro"
                    android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent"
                    android:layout_gravity="center" android:gravity="center" android:orientation="horizontal">
                    <ImageView android:id="@+id/av_b1_ic" android:layout_width="15dp" android:layout_height="15dp"
                        android:layout_marginEnd="7dp" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/av_b1_tx" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="14sp" android:fontFamily="@font/outfit_bold" android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/av_b2" android:layout_width="0dp" android:layout_height="42dp"
                android:layout_weight="1" android:layout_marginStart="8dp" android:visibility="gone">
                <ImageView android:id="@+id/av_b2_borde" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="fitXY" android:src="@drawable/aviso_boton" android:importantForAccessibility="no" />
                <ImageView android:id="@+id/av_b2_fondo" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:layout_margin="1.5dp" android:scaleType="fitXY" android:src="@drawable/aviso_boton_dentro"
                    android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent"
                    android:layout_gravity="center" android:gravity="center" android:orientation="horizontal">
                    <ImageView android:id="@+id/av_b2_ic" android:layout_width="15dp" android:layout_height="15dp"
                        android:layout_marginEnd="7dp" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/av_b2_tx" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="14sp" android:fontFamily="@font/outfit_bold" android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
