<?xml version="1.0" encoding="utf-8"?>
<!-- Racha: las semanas encendidas y los días de esta semana.
     Un marco, Outfit y los tonos del mundo: los colores los pone el código y los de aquí son
     los de la casa de noche, para el selector de widgets. En dp y no en sp, como Hoy. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:id="@+id/wh_borde" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_marco" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/wh_fondo" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_margin="1dp" android:scaleType="fitXY" android:src="@drawable/widget_marco_dentro"
        android:importantForAccessibility="no" />

    <LinearLayout android:id="@+id/w_cuerpo" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp">
        <LinearLayout android:id="@+id/w_cab" android:layout_width="match_parent" android:layout_height="24dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/w_ic" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/widget_ic_brasa" android:importantForAccessibility="no" />
            <TextView android:id="@+id/w_titulo" android:layout_height="wrap_content" android:textSize="12dp" android:fontFamily="@font/outfit_semibold" android:textColor="#FFEEF3F1" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:text="Racha" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="6dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:orientation="horizontal" android:gravity="bottom">
            <TextView android:id="@+id/wr_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="38.5dp" android:fontFamily="@font/outfit_semibold" android:textColor="#FFEEF3F1" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:text="0" android:fontFeatureSettings="tnum" />
            <TextView android:id="@+id/wr_rot" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="8dp" android:layout_marginBottom="3dp" android:textSize="10.5dp" android:fontFamily="@font/outfit_medium"
                android:textColor="#FF93A0AB" android:includeFontPadding="false" android:maxLines="2" />
        </LinearLayout>
        <ImageView android:id="@+id/wr_semana" android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="12dp"
            android:scaleType="fitXY" android:importantForAccessibility="no" />
        <FrameLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/wr_nota" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11dp"
            android:fontFamily="@font/outfit_semibold" android:textColor="#FF93A0AB" android:includeFontPadding="false" android:maxLines="3" />
    </LinearLayout>
</FrameLayout>
