<?xml version="1.0" encoding="utf-8"?>
<!-- Siguiente nodo: el paso que toca de una rama, con la figura de su nodo.
     Un marco, Outfit y los tonos del mundo: los colores los pone el código y los de aquí son
     los de la casa de noche, para el selector de widgets. En dp y no en sp, como Hoy. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:id="@+id/wh_borde" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_marco" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/wh_fondo" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_margin="1dp" android:scaleType="fitXY" android:src="@drawable/widget_marco_dentro"
        android:importantForAccessibility="no" />

    <LinearLayout android:id="@+id/w_cuerpo" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="16dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/wn_fig" android:layout_width="46dp" android:layout_height="46dp" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="13dp"
            android:orientation="vertical">
            <TextView android:id="@+id/wn_r1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10.5dp" android:fontFamily="@font/outfit_medium" android:textColor="#FF93A0AB" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:text="Siguiente nodo" />
            <TextView android:id="@+id/wn_r2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14dp" android:fontFamily="@font/outfit_semibold" android:textColor="#FFEEF3F1" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="1dp" />
            <LinearLayout android:id="@+id/wn_avance" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/wn_barra" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1"
                    android:scaleType="fitXY" android:importantForAccessibility="no" />
                <TextView android:id="@+id/wn_cuenta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10.5dp" android:fontFamily="@font/outfit_medium" android:textColor="#FF93A0AB" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="8dp" android:fontFeatureSettings="tnum" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
