<?xml version="1.0" encoding="utf-8"?>
<!-- Expedición: el aro de nivel y lo próximo que se abre.
     Un marco, Outfit y los tonos del mundo: los colores los pone el código y los de aquí son
     los de la casa de noche, para el selector de widgets. En dp y no en sp, como Hoy. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:id="@+id/wh_borde" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_marco" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/wh_fondo" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_margin="1dp" android:scaleType="fitXY" android:src="@drawable/widget_marco_dentro"
        android:importantForAccessibility="no" />

    <LinearLayout android:id="@+id/w_cuerpo" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp">
        <LinearLayout android:id="@+id/w_cab" android:layout_width="match_parent" android:layout_height="24dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/w_ic" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/widget_ic_bandera" android:importantForAccessibility="no" />
            <TextView android:id="@+id/w_titulo" android:layout_height="wrap_content" android:textSize="12dp" android:fontFamily="@font/outfit_semibold" android:textColor="#FFEEF3F1" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:text="Expedición" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="6dp" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <ImageView android:id="@+id/we_aro" android:layout_width="94dp" android:layout_height="94dp" android:layout_gravity="center"
                android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
                android:orientation="vertical" android:gravity="center_horizontal">
                <TextView android:id="@+id/we_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="26dp" android:fontFamily="@font/outfit_semibold" android:textColor="#FFEEF3F1" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:fontFeatureSettings="tnum" />
                <TextView android:id="@+id/we_niv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9.5dp" android:fontFamily="@font/outfit_medium" android:textColor="#FF93A0AB" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
            <ImageView android:id="@+id/we_candado" android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/widget_ic_candado" android:importantForAccessibility="no" android:layout_marginEnd="5dp" />
            <TextView android:id="@+id/we_linea" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10.5dp" android:fontFamily="@font/outfit_medium" android:textColor="#FF93A0AB" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <FrameLayout android:id="@+id/we_chip" android:layout_width="wrap_content" android:layout_height="20dp" android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp" android:visibility="gone">
            <ImageView android:id="@+id/we_chip_fondo" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitXY" android:src="@drawable/widget_boton" android:importantForAccessibility="no" />
            <TextView android:id="@+id/we_chip_tx" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center"
                android:paddingStart="9dp" android:paddingEnd="9dp" android:textSize="10dp" android:fontFamily="@font/outfit_semibold"
                android:includeFontPadding="false" android:maxLines="1" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
