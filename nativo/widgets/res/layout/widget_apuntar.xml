<?xml version="1.0" encoding="utf-8"?>
<!-- Apuntar: un toque y ya estás escribiendo una misión; dos atajos debajo.
     Un marco, Outfit y los tonos del mundo: los colores los pone el código y los de aquí son
     los de la casa de noche, para el selector de widgets. En dp y no en sp, como Hoy. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:id="@+id/wh_borde" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_marco" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/wh_fondo" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_margin="1dp" android:scaleType="fitXY" android:src="@drawable/widget_marco_dentro"
        android:importantForAccessibility="no" />

    <LinearLayout android:id="@+id/w_cuerpo" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp">
        <LinearLayout android:id="@+id/w_cab" android:layout_width="match_parent" android:layout_height="24dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/w_ic" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/widget_ic_lapiz" android:importantForAccessibility="no" />
            <TextView android:id="@+id/w_titulo" android:layout_height="wrap_content" android:textSize="14dp" android:fontFamily="@font/outfit_semibold" android:textColor="#FFEEF3F1" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:text="Apuntar" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="6dp" />
        </LinearLayout>
        <FrameLayout android:id="@+id/wa_mision" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp">
            <ImageView android:id="@+id/wa_mision_fondo" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitXY" android:src="@drawable/widget_caja" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="center"
                android:orientation="horizontal" android:gravity="center">
                <ImageView android:id="@+id/wa_mision_ic" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/widget_ic_mas" android:importantForAccessibility="no" />
                <TextView android:id="@+id/wa_mision_tx" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14.5dp" android:fontFamily="@font/outfit_bold" android:textColor="#FF10151D" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:text="Misión" android:layout_marginStart="7dp" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <FrameLayout android:id="@+id/wa_hab" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <ImageView android:id="@+id/wa_hab_fondo" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="fitXY" android:src="@drawable/widget_caja" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
                    android:orientation="vertical" android:gravity="center_horizontal">
                    <ImageView android:id="@+id/wa_hab_ic" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/widget_ic_estrella" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/wa_hab_tx" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11.5dp" android:fontFamily="@font/outfit_semibold" android:textColor="#FF5FE0B0" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:text="Habilidad" android:layout_marginTop="5dp" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/wa_reloj" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp">
                <ImageView android:id="@+id/wa_reloj_fondo" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="fitXY" android:src="@drawable/widget_caja" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
                    android:orientation="vertical" android:gravity="center_horizontal">
                    <ImageView android:id="@+id/wa_reloj_ic" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/widget_ic_reloj" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/wa_reloj_tx" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11.5dp" android:fontFamily="@font/outfit_semibold" android:textColor="#FF5FE0B0" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:text="Reloj" android:layout_marginTop="5dp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
