<?xml version="1.0" encoding="utf-8"?>
<!-- letras al 87 % de las del boceto: se veian grandes junto a lo demas del telefono (3 oct 2026). -->
<!-- El widget Hoy. Un marco, Outfit y los tonos del mundo, como los avisos: los
     colores los pone el código (HoyWidget.java) y aquí todo es blanco o vacío.
     En dp y no en sp: el alto lo pone la cuadrícula del teléfono, y con la letra
     del sistema agrandada las filas se saldrían. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:id="@+id/wh_borde" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_marco" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/wh_fondo" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_margin="1dp" android:scaleType="fitXY" android:src="@drawable/widget_marco_dentro"
        android:importantForAccessibility="no" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp">

        <LinearLayout android:id="@+id/wh_cab" android:layout_width="match_parent" android:layout_height="24dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/wh_ic" android:layout_width="16dp" android:layout_height="16dp"
                android:src="@drawable/widget_ic_hoy" android:importantForAccessibility="no" />
            <TextView android:id="@+id/wh_titulo" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="6dp" android:textSize="12dp"
                android:fontFamily="@font/outfit_semibold" android:maxLines="1" android:ellipsize="end"
                android:includeFontPadding="false" android:text="Hoy" android:textColor="#FFEEF3F1" />
            <TextView android:id="@+id/wh_cuenta" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10.5dp" android:fontFamily="@font/outfit_medium" android:fontFeatureSettings="tnum"
                android:maxLines="1" android:includeFontPadding="false" />
            <ImageView android:id="@+id/wh_aro" android:layout_width="18dp" android:layout_height="18dp"
                android:layout_marginStart="6dp" android:visibility="gone" android:importantForAccessibility="no" />
        </LinearLayout>

        <FrameLayout android:id="@+id/wh_tira" android:layout_width="match_parent" android:layout_height="30dp"
            android:layout_marginTop="6dp" android:visibility="gone">
            <ImageView android:id="@+id/wh_tira_fondo" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitXY" android:src="@drawable/widget_tira" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="10dp" android:paddingEnd="10dp">
                <ImageView android:id="@+id/wh_tira_punto" android:layout_width="8dp" android:layout_height="8dp"
                    android:src="@drawable/widget_punto" android:importantForAccessibility="no" />
                <TextView android:id="@+id/wh_tira_rot" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:textSize="10.5dp" android:fontFamily="@font/outfit_bold"
                    android:maxLines="1" android:includeFontPadding="false" />
                <TextView android:id="@+id/wh_tira_nom" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="6dp" android:textSize="11.5dp"
                    android:fontFamily="@font/outfit_medium" android:maxLines="1" android:ellipsize="end"
                    android:includeFontPadding="false" />
                <TextView android:id="@+id/wh_tira_de" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:textSize="10.5dp" android:fontFamily="@font/outfit_medium"
                    android:fontFeatureSettings="tnum" android:maxLines="1" android:includeFontPadding="false" />
            </LinearLayout>
        </FrameLayout>

        <ListView android:id="@+id/wh_lista" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginTop="4dp" android:divider="@null" android:dividerHeight="0dp"
            android:scrollbars="none" android:listSelector="@android:color/transparent"
            android:fadingEdgeLength="22dp" android:requiresFadingEdge="vertical"
            android:overScrollMode="never" />

        <LinearLayout android:id="@+id/wh_vacio" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical"
            android:visibility="gone">
            <TextView android:id="@+id/wh_vacio_tx" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="11.5dp" android:fontFamily="@font/outfit_medium" android:includeFontPadding="false" />
            <FrameLayout android:id="@+id/wh_vacio_b" android:layout_width="wrap_content" android:layout_height="34dp"
                android:layout_marginTop="10dp">
                <ImageView android:id="@+id/wh_vacio_b_fondo" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="fitXY" android:src="@drawable/widget_boton" android:importantForAccessibility="no" />
                <TextView android:id="@+id/wh_vacio_b_tx" android:layout_width="wrap_content" android:layout_height="match_parent"
                    android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:textSize="11.5dp"
                    android:fontFamily="@font/outfit_bold" android:maxLines="1" android:includeFontPadding="false" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
