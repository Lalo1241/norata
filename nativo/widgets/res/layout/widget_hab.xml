<?xml version="1.0" encoding="utf-8"?>
<!-- Por cuidar: la habilidad que lleva más días sin práctica, y la misión que la mantiene.
     Un marco, la letra del sistema y los tonos del mundo: los colores los pone el código y los de aquí son
     los de la casa de noche, para el selector de widgets. En dp y no en sp, como Hoy. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:id="@+id/wh_borde" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_marco" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/wh_fondo" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_margin="1dp" android:scaleType="fitXY" android:src="@drawable/widget_marco_dentro"
        android:importantForAccessibility="no" />

    <LinearLayout android:id="@+id/w_cuerpo" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp">
        <LinearLayout android:id="@+id/w_cab" android:layout_width="match_parent" android:layout_height="24dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/w_ic" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/widget_ic_corazon" android:importantForAccessibility="no" />
            <TextView android:id="@+id/w_titulo" android:layout_height="wrap_content" android:textSize="12dp" android:textStyle="bold" android:textColor="#FFEEF3F1" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:text="Por cuidar" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="6dp" />
        </LinearLayout>
        <TextView android:id="@+id/wc_vacio" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:gravity="center_vertical" android:textSize="11.5dp" android:fontFamily="sans-serif-medium" android:textColor="#FF93A0AB"
            android:includeFontPadding="false" android:visibility="gone" />
        <LinearLayout android:id="@+id/wc_todo" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:orientation="horizontal" android:gravity="center_vertical">
                <FrameLayout android:layout_width="36dp" android:layout_height="36dp">
                    <ImageView android:id="@+id/wc_caja" android:layout_width="match_parent" android:layout_height="match_parent"
                        android:scaleType="fitXY" android:src="@drawable/widget_caja12" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/wc_ic" android:layout_width="19dp" android:layout_height="19dp" android:layout_gravity="center"
                        android:src="@drawable/widget_ic_nota" android:importantForAccessibility="no" />
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="9dp"
                    android:orientation="vertical">
                    <TextView android:id="@+id/wc_nom" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13dp" android:textStyle="bold" android:textColor="#FFEEF3F1" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
                    <TextView android:id="@+id/wc_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10.5dp" android:fontFamily="sans-serif-medium" android:textColor="#FF93A0AB" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>
            <ImageView android:id="@+id/wc_barra" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="10dp"
                android:scaleType="fitXY" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <ImageView android:id="@+id/wc_punto" android:layout_width="7dp" android:layout_height="7dp" android:layout_marginTop="4dp"
                    android:src="@drawable/widget_punto" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="7dp"
                    android:orientation="vertical">
                    <TextView android:id="@+id/wc_a1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11dp" android:fontFamily="sans-serif-medium" android:textColor="#FFEEF3F1" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
                    <TextView android:id="@+id/wc_a2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10.5dp" android:fontFamily="sans-serif-medium" android:textColor="#FF93A0AB" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
            <FrameLayout android:id="@+id/wc_b" android:layout_width="match_parent" android:layout_height="34dp">
                <ImageView android:id="@+id/wc_b_fondo" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="fitXY" android:src="@drawable/widget_boton" android:importantForAccessibility="no" />
                <TextView android:id="@+id/wc_b_tx" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center"
                    android:textSize="11.5dp" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="1" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
