<?xml version="1.0" encoding="utf-8"?>
<!-- Pomodoro, ancho (4×2): la rueda chica con la cuenta, y a un lado lo que toca y el botón.
     Un marco, Outfit y los tonos del mundo: los colores los pone el código y los de aquí son
     los de la casa de noche, para el selector de widgets. En dp y no en sp, como Hoy. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:id="@+id/wh_borde" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_marco" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/wh_fondo" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_margin="1dp" android:scaleType="fitXY" android:src="@drawable/widget_marco_dentro"
        android:importantForAccessibility="no" />

    <LinearLayout android:id="@+id/w_cuerpo" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp">
        <LinearLayout android:id="@+id/w_cab" android:layout_width="match_parent" android:layout_height="24dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/w_ic" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/widget_ic_arena" android:importantForAccessibility="no" />
            <TextView android:id="@+id/w_titulo" android:layout_height="wrap_content" android:textSize="12dp" android:fontFamily="@font/outfit_semibold" android:textColor="#FFEEF3F1" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:text="Pomodoro" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="6dp" />
            <TextClock android:id="@+id/wp_ahora" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10.5dp" android:fontFamily="@font/outfit_medium" android:fontFeatureSettings="tnum" android:textColor="#FF93A0AB" android:includeFontPadding="false" android:format12Hour="h:mm" android:format24Hour="h:mm" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal"
            android:gravity="center_vertical">
            <FrameLayout android:layout_width="150dp" android:layout_height="match_parent">
                <ImageView android:id="@+id/wp_rueda" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="fitCenter" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
                    android:orientation="vertical" android:gravity="center_horizontal">
                    <ImageView android:id="@+id/wp_arena" android:layout_width="22dp" android:layout_height="22dp" android:importantForAccessibility="no" />
                    <Chronometer android:id="@+id/wp_crono" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="17.5dp"
                    android:fontFamily="@font/outfit_semibold" android:fontFeatureSettings="tnum" android:textColor="#FFEEF3F1" android:includeFontPadding="false"
                    android:visibility="gone" />
                <TextView android:id="@+id/wp_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="17.5dp" android:fontFamily="@font/outfit_semibold" android:textColor="#FFEEF3F1" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:text="25:00" android:fontFeatureSettings="tnum" />
                </LinearLayout>
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView android:id="@+id/wp_rot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14dp" android:fontFamily="@font/outfit_semibold" android:textColor="#FFEEF3F1" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/wp_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:textSize="10.5dp" android:fontFamily="@font/outfit_medium" android:textColor="#FF93A0AB" android:includeFontPadding="false" android:maxLines="2" />
                <ImageView android:id="@+id/wp_tramos" android:layout_width="44dp" android:layout_height="9dp" android:layout_marginTop="7dp"
                    android:scaleType="fitStart" android:importantForAccessibility="no" />
        <FrameLayout android:layout_marginTop="10dp" android:id="@+id/wp_b" android:layout_width="match_parent" android:layout_height="34dp">
            <ImageView android:id="@+id/wp_b_fondo" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitXY" android:src="@drawable/widget_boton" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="center"
                android:orientation="horizontal" android:gravity="center">
                <ImageView android:id="@+id/wp_b_ic" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/widget_ic_play" android:importantForAccessibility="no" />
                <TextView android:id="@+id/wp_b_tx" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11.5dp" android:fontFamily="@font/outfit_semibold" android:textColor="#FF10151D" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="7dp" />
            </LinearLayout>
        </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
