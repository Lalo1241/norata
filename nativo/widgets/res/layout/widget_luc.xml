<?xml version="1.0" encoding="utf-8"?>
<!-- Luciérnagas: una por misión de hoy. La escena entera es una imagen que dibuja el código; se queda de noche en los dos modos.
     Un marco, la letra del sistema y los tonos del mundo: los colores los pone el código y los de aquí son
     los de la casa de noche, para el selector de widgets. En dp y no en sp, como Hoy. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:id="@+id/wl_escena" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:importantForAccessibility="no" />

    <LinearLayout android:id="@+id/w_cuerpo" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/w_ic" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/widget_ic_chispa" android:importantForAccessibility="no" />
            <TextView android:id="@+id/w_titulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12dp" android:textStyle="bold" android:textColor="#FFEEF3F1" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:text="Luciérnagas" android:layout_marginStart="6dp" />
        </LinearLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="true">
            <TextView android:id="@+id/wl_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22.5dp" android:textStyle="bold" android:textColor="#FFEEF3F1" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:fontFeatureSettings="tnum" />
            <TextView android:id="@+id/wl_de" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11.5dp" android:fontFamily="sans-serif-medium" android:textColor="#FFA9B7C9" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="4dp" />
        </LinearLayout>
        <TextView android:id="@+id/wl_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10.5dp" android:fontFamily="sans-serif-medium" android:textColor="#FFA9B7C9" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
