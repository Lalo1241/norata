<?xml version="1.0" encoding="utf-8"?>
<!-- Lo que sigue: una sola misión, la que toca. El círculo la marca; lo demás abre Misiones.
     Un marco, Outfit y los tonos del mundo: los colores los pone el código y los de aquí son
     los de la casa de noche, para el selector de widgets. En dp y no en sp, como Hoy. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:id="@+id/wh_borde" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_marco" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/wh_fondo" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_margin="1dp" android:scaleType="fitXY" android:src="@drawable/widget_marco_dentro"
        android:importantForAccessibility="no" />

    <LinearLayout android:id="@+id/w_cuerpo" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/ws_marca" android:layout_width="48dp" android:layout_height="48dp" android:importantForAccessibility="no" />
        <LinearLayout android:id="@+id/ws_txt" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="13dp" android:orientation="vertical">
            <TextView android:id="@+id/ws_r1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12dp" android:fontFamily="@font/outfit_medium" android:textColor="#FF93A0AB" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:text="Lo que sigue" />
            <TextView android:id="@+id/ws_r2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16dp" android:fontFamily="@font/outfit_semibold" android:textColor="#FFEEF3F1" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="1dp" />
            <TextView android:id="@+id/ws_r3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12dp" android:fontFamily="@font/outfit_medium" android:textColor="#FF93A0AB" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="1dp" />
        </LinearLayout>
        <ImageView android:id="@+id/ws_flecha" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/widget_ic_flecha" android:importantForAccessibility="no" android:layout_marginStart="8dp" />
    </LinearLayout>
</FrameLayout>
