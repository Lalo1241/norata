<?xml version="1.0" encoding="utf-8"?>
<!-- El chorro del reloj de arena del widget del Pomodoro, cayendo (0.7.214).
     Cuatro cuadros de una raya a trozos, cada uno un paso más abajo: lo mismo
     que `@keyframes jor-caer` en la app, medio segundo la vuelta. Va como dibujo
     de una barra de progreso sin fin, que es lo único que Android anima solo
     dentro de un widget. El tono es el de la arena de noche; desde Android 12
     lo tiñe el código con el de la foto. -->
<animation-list xmlns:android="http://schemas.android.com/apk/res/android" android:oneshot="false">
    <item android:drawable="@drawable/widget_chorro_1" android:duration="125" />
    <item android:drawable="@drawable/widget_chorro_2" android:duration="125" />
    <item android:drawable="@drawable/widget_chorro_3" android:duration="125" />
    <item android:drawable="@drawable/widget_chorro_4" android:duration="125" />
</animation-list>
