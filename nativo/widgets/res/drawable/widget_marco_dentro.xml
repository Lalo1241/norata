<?xml version="1.0" encoding="utf-8"?>
<!-- El marco del widget, por dentro (el fondo): 1 dp más chico que el de fuera. El color de verdad lo pone el código (setColorFilter), porque cambia con el
     mundo y un widget no deja leer variables; el de aquí es el de la casa de noche, que es
     lo que se ve en el selector de widgets antes de ponerlo. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FF1B222C" />
    <corners android:radius="19dp" />
</shape>
