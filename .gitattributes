# Los hooks se ejecutan con sh, y un sh no entiende un retorno de carro al
# final de la línea: en el árbol CRLF de Windows fallarían con «$'\r':
# command not found». Solo ellos; el resto sigue como estaba.
.githooks/* text eol=lf
# Lo mismo para los guiones de consola de `herramientas/`.
herramientas/*.sh text eol=lf
# Lo que genera `herramientas/novedades-framer.py` sale sin retorno de carro
# y así se queda, para que regenerarlo en Windows no lo marque como cambiado.
novedades/framer.csv text eol=lf
novedades/img/*.svg text eol=lf
