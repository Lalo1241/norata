#!/bin/sh
# Al subir: el estado final de cada rama que se empuja. Es la red que
# importa, porque `git rebase --continue` se salta pre-commit y fue un
# rebase lo que coló las marcas de la 0.7.148. Ver marcas-de-conflicto.sh.
#
# Se mira el árbol de la punta y no commit por commit: lo que llega a la
# web y al paquete es la punta, y un commit intermedio con marcas que el
# siguiente ya arregló no rompe nada.
comprobar="$(git rev-parse --show-toplevel)/.githooks/marcas-de-conflicto.sh"
cero=0000000000000000000000000000000000000000
fallo=0
while read -r _local sha _remota _rsha; do
  # `vivo` es lo publicado, y solo la mueve la barrera
  # (.github/workflows/barrera.yml) cuando Eduardo aprueba. Subir ahí a mano
  # se salta la aprobación entera. Para una emergencia de verdad:
  # NORATA_VIVO_A_MANO=1 git push …, y decírselo a Eduardo.
  if [ "$_remota" = "refs/heads/vivo" ] && [ "${NORATA_VIVO_A_MANO:-}" != "1" ]; then
    echo "No se sube a 'vivo' a mano: es lo publicado y lo mueve la barrera." >&2
    echo "Sube a 'main' y corre: sh herramientas/barrera.sh" >&2
    exit 1
  fi
  [ "$sha" = "$cero" ] && continue   # borrar una rama no sube nada
  sh "$comprobar" "$sha" || fallo=1
done
exit $fallo
